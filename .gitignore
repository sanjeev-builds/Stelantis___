# ==============================
# Python (any folder)
# ==============================
__pycache__/
**/__pycache__/
*.pyc

# ==============================
# Root / OS
# ==============================
.DS_Store
Thumbs.db
*.log
*.tmp
.env
.env.*
!.env*.example

# ==============================
# Frontend (Next.js / React / Tailwind)
# ==============================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.env*.local
frontend/coverage/

# ==============================
# Backend (FastAPI / Python)
# ==============================
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/
backend/env/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.egg-info/
backend/dist/
backend/build/
backend/.coverage
backend/htmlcov/

# ==============================
# AI (LangChain / ChromaDB / Gemini)
# ==============================
ai/__pycache__/
ai/**/__pycache__/
ai/*.pyc
ai/.venv/
ai/venv/
ai/.ipynb_checkpoints/
ai/**/*.ipynb_checkpoints/
ai/.cache/

# ==============================
# Database
# ==============================
*.sqlite3
*.db
pgdata/
postgres-data/

# ==============================
# Editors / IDEs
# ==============================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ==============================
# Secrets & credentials (never commit)
# ==============================
*.pem
*.key
credentials.json
secrets.yaml
